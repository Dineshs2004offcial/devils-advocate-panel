# ==============================================================================
# DEVIL'S ADVOCATE PANEL - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to '.env' in the project root:
#   cp .env.example .env
#
# NOTE: The system features automated cascading fallback across LLM providers.
# Provide AT LEAST ONE LLM API key below (Groq is recommended for fastest inference).
# All other services will gracefully fall back to local/in-memory mocks if omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Keys (At least ONE recommended for full multi-agent generation)
# ------------------------------------------------------------------------------
# [RECOMMENDED] Groq API Key - Ultra-fast inference (<500ms) for multi-round debate turns
GROQ_API_KEY=gsk_your_groq_api_key_here

# [RECOMMENDED] Google Gemini API Key - Large context processing for RAG & market synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# [OPTIONAL] OpenAI API Key - High-precision structured output & JSON judge verdicts
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# [OPTIONAL] Mistral AI API Key - Alternative reasoning benchmark provider
MISTRAL_API_KEY=your_mistral_api_key_here

# [OPTIONAL] OpenRouter API Key - Gateway fallback for open-weights models
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 2. LLM Model Overrides (OPTIONAL - Defaults are pre-configured)
# ------------------------------------------------------------------------------
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# 3. Web Research MCP Tool (OPTIONAL)
# ------------------------------------------------------------------------------
# Enables live web market intelligence & competitor search via Tavily
# (Falls back to DuckDuckGo / mock research if not provided)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database (OPTIONAL - Falls back to in-memory session engine)
# ------------------------------------------------------------------------------
# Connection string for persistent pitch histories and evaluation transcripts
DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/devils_advocate

# Individual connection parameters (used by PostgreSQL MCP connector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devils_advocate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ------------------------------------------------------------------------------
# 5. Vector Database & RAG (OPTIONAL - Local ChromaDB defaults are configured)
# ------------------------------------------------------------------------------
# Local directory for ChromaDB vector embeddings
CHROMA_PERSIST_DIR=./data/chroma_db

# HuggingFace sentence transformer embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
